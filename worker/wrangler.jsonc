{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-ai-agent",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://www.ythsieh.dev",
    "GROQ_MODEL": "openai/gpt-oss-120b"
  },
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "912001", "simple": { "limit": 6, "period": 60 } },
    { "name": "SITE_LIMITER", "namespace_id": "912002", "simple": { "limit": 30, "period": 60 } }
  ]
}
